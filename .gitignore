# APK / 大包（不进 Git）
/**/*.apk
/**/*.apK
/**/*.APK
/install/apk/imports/
/*.zip
/*.xls
/*.xlsx
*.idsig
*.ew4mod
*.ew4mod.previous
/apk_work/

# build/ — MSBuild bin/obj
/build/**
!/build/README.md

# mods/ — 本地 base 等大包忽略；示例 Mod 目录白名单进 Git
/mods/*
!/mods/README.md
!/mods/ex-commander-skills/
!/mods/ex-commander-skills/**
!/mods/ex-campaign-tweak/
!/mods/ex-campaign-tweak/**
!/mods/ex-conquest-tweak/
!/mods/ex-conquest-tweak/**

# data/ — 生成 mods/base 用的原料（可选，本地保留）
/data/

# install/ — 发行产物
/install/**
!/install/README.md

# 本地 dev Web 状态（scripts/ew4.sh web）
/.run/

# Legacy
/local/**
/packs/
/workspaces/
/.ew4-host/

**/bin/
**/obj/
**/node_modules/
**/__pycache__/
*.pyc
.vs/
