# syntax=docker/dockerfile:1
# 唯一开发镜像 ew4-dev:local：.NET SDK + Python/Node + Android 工具链（apk 壳 + export-apk）。
FROM mcr.microsoft.com/dotnet/sdk:10.0
ARG APKTTOOL_VERSION=2.9.3
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    python3 nodejs npm ca-certificates curl unzip zip \
    openjdk-17-jdk-headless \
 && curl -fsSL -o /usr/local/bin/apktool.jar \
    "https://github.com/iBotPeaches/Apktool/releases/download/v${APKTTOOL_VERSION}/apktool_${APKTTOOL_VERSION}.jar" \
 && printf '%s\n' '#!/bin/sh' 'exec java -jar /usr/local/bin/apktool.jar "$@"' > /usr/local/bin/apktool \
 && chmod +x /usr/local/bin/apktool \
 && rm -rf /var/lib/apt/lists/*
ENV ANDROID_HOME=/opt/android-sdk
RUN mkdir -p $ANDROID_HOME/cmdline-tools \
 && curl -fsSL -o /tmp/cmdline.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
 && unzip -q /tmp/cmdline.zip -d $ANDROID_HOME/cmdline-tools \
 && mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest \
 && rm /tmp/cmdline.zip \
 && yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses >/dev/null \
 && $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager "platforms;android-34" "build-tools;34.0.0" >/dev/null
ENV PATH="$ANDROID_HOME/build-tools/34.0.0:${PATH}"
WORKDIR /src
ENV DOTNET_NOLOGO=1 \
    PATH="/src/scripts/dev:${PATH}"
