{
  "conquest1": [
    {
      "id": "legion.dispatch",
      "popup": {
        "title": "军团出征",
        "text": "是否派遣军团？出征后每三回合调拨一次军费与补给。",
        "choices": [
          {"id": "dispatch", "text": "出征", "effects": [{"type": "state", "key": "scenario/expedition", "value": 1}]},
          {"id": "stay", "text": "留守", "effects": [{"type": "state", "key": "scenario/expedition", "value": 0}]}
        ]
      }
    },
    {
      "id": "legion.upkeep",
      "repeat": {"everyRounds": 3, "startRound": 3},
      "condition": {"type": "all", "conditions": [
        {"type": "state", "key": "scenario/expedition", "value": 1},
        {"type": "relation", "faction": "conquest1.faction.0.fra", "otherFaction": "conquest1.faction.2.koi", "relation": "allied"},
        {"type": "not", "conditions": [{"type": "faction_defeated", "faction": "conquest1.faction.2.koi"}]}
      ]},
      "effects": [
        {"type": "money", "faction": "conquest1.faction.0.fra", "value": -10},
        {"type": "food", "faction": "conquest1.faction.0.fra", "value": -20},
        {"type": "industry", "faction": "conquest1.faction.0.fra", "value": -1},
        {"type": "money", "faction": "conquest1.faction.2.koi", "value": 5},
        {"type": "food", "faction": "conquest1.faction.2.koi", "value": 10},
        {"type": "industry", "faction": "conquest1.faction.2.koi", "value": 1}
      ],
      "insufficientResourcesEffects": [
        {"type": "add_state", "key": "scenario/shortages", "value": 1},
        {"type": "state", "key": "scenario/expedition", "value": 0}
      ]
    },
    {
      "id": "legion.diplomacy",
      "condition": {"type": "round", "value": 4},
      "popup": {
        "title": "军团的去向",
        "text": "军团与法国之间的关系将如何变化？",
        "choices": [
          {"id": "hostile", "text": "军团叛离，双方敌对", "effects": [
            {"type": "relation", "faction": "conquest1.faction.0.fra", "otherFaction": "conquest1.faction.2.koi", "relation": "hostile"},
            {"type": "state", "key": "scenario/route", "value": 1}
          ]},
          {"id": "neutral", "text": "军团独立，双方中立", "effects": [
            {"type": "relation", "faction": "conquest1.faction.0.fra", "otherFaction": "conquest1.faction.2.koi", "relation": "neutral"},
            {"type": "state", "key": "scenario/route", "value": 2}
          ]},
          {"id": "default", "text": "维持原阵营关系", "effects": [
            {"type": "relation", "faction": "conquest1.faction.0.fra", "otherFaction": "conquest1.faction.2.koi", "relation": "default"},
            {"type": "state", "key": "scenario/route", "value": 3}
          ]}
        ]
      }
    }
  ]
}
